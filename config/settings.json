{
  "language": "ru",
  "authorship_mark": "",
  "limits": {
    "page_timeout_s": 30,
    "light_page_timeout_s": 15,
    "hard_timeout_grace_s": 10,
    "max_scrolls": 15,
    "no_new_rounds_to_stop": 3,
    "max_expansions": 25,
    "max_jobs_per_page": 100,
    "max_text_chars": 2000000,
    "max_requests_per_page": 400,
    "max_frames": 10,
    "max_json_responses": 30,
    "max_json_bytes": 2000000,
    "max_pdf_bytes": 10000000,
    "max_pdf_pages": 50
  },
  "run": {
    "max_pages_per_run": 40,
    "max_pages_per_start": 15,
    "max_run_seconds": 900,
    "max_depth": 1,
    "max_followed_per_page": 15,
